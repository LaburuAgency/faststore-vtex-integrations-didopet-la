{
  "header": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header.full": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },

  // Desktop
  "header-layout.desktop": {
    "children": [
      "sticky-layout#4-desktop"
    ]
  },
  "flex-layout.col#spacer": {
    "props": {
      "width": "grow"
    }
  },
  "sticky-layout#4-desktop": {
    "props": {
      "blockClass": "sticky-header"
    },
    "children": ["flex-layout.row#4-desktop"]
  },
  "flex-layout.row#4-desktop": {
    "props": {
      "blockClass": "main-header",
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true
    },
    "children": [
      "flex-layout.col#logo-desktop",
      "flex-layout.col#spacer",
      "flex-layout.col#back-to-store"
    ]
  },
  "flex-layout.col#logo-desktop": {
    "props": {
      "verticalAlign": "middle"
    },
    "children": ["logo#desktop"]
  },
  "logo#desktop": {
    "props": {
      "title": "Didopet",
      "href": "https://www.innovacionsamurai.com/",
      "url": "assets/logo-didopet-login.svg",
      "width": "56"
    }
  },
  // Link "Volver a la tienda": solo se muestra en /account (ver
  // .back-to-store en vtex.flex-layout.css, acotado a .render-route-store-account),
  // en el resto de páginas queda oculto vía CSS.
  "flex-layout.col#back-to-store": {
    "props": {
      "verticalAlign": "middle",
      "blockClass": "back-to-store"
    },
    "children": ["rich-text#back-to-store"]
  },
  "rich-text#back-to-store": {
    "props": {
      "text": "[Volver a la tienda](/)",
      "font": "t-action--small",
      "textColor": "c-on-emphasis",
      "blockClass": "back-to-store-link"
    }
  },

  // Mobile
  "header-layout.mobile": {
    "children": ["sticky-layout#1-mobile"]
  },
  "sticky-layout#1-mobile": {
    "children": ["flex-layout.row#1-mobile"]
  },
  "flex-layout.row#1-mobile": {
    "children": [
      "logo#mobile",
      "flex-layout.col#spacer"
    ],
    "props": {
      "blockClass": "main-header-mobile",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "logo#mobile": {
    "props": {
      "title": "Didopet",
      "href": "https://www.innovacionsamurai.com/",
      "url": "assets/logo-didopet-login.svg",
      "width": "42"
    }
  }
}
